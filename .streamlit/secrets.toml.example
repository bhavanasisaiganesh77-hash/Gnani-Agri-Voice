# Copy this file to .streamlit/secrets.toml (local) or paste it into
# Streamlit Community Cloud > App settings > Secrets. NEVER commit secrets.toml.

GNANI_API_KEY = "your_gnani_api_key_here"

# Agricultural reasoning (Claude via Anthropic's Messages API)
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"
ANTHROPIC_MODEL = "claude-sonnet-5-5"

# Optional: change the per-user hourly limit on AI answers
# AI_REPLIES_PER_HOUR = "40"

# --- Google sign-in (optional; the button only appears when this is complete) ---
[auth]
# Must match an Authorized redirect URI in Google Cloud.
# Local: http://localhost:8501/oauth2callback   Deployed: https://YOUR-APP.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "a-long-random-string"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

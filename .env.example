# Copy this file to .env and fill in your values. NEVER commit .env or share it.

# --- Gnani: speech to text AND text to speech use the same key ---
GNANI_API_KEY=your_gnani_api_key_here

# --- Agricultural reasoning (Claude, Anthropic Messages API) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: use any OpenAI-compatible provider instead (set LLM_PROVIDER=openai_compatible) ---
# LLM_API_KEY=your_llm_provider_key_here
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=a_model_id_from_your_provider

# --- Optional ---
# SESSION_IDLE_MINUTES=60
# VOICE_STUDIO_DB=./agri_voice.db
# AI_REPLIES_PER_HOUR=40
